<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>✉️ Письмо Деду Морозу ✉️</h1>
        
        <% if (locals.error) { %>
            <div class="error">
                <%= error %>
            </div>
        <% } %>
        
        <form action="/submit-letter" method="POST">
            <div class="form-group">
                <label for="name">Как тебя зовут?</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    value="<%= locals.formData ? formData.name : '' %>"
                    placeholder="Например: Саша"
                    required
                >
            </div>
            
            <div class="form-group">
                <label for="age">Сколько тебе лет?</label>
                <input 
                    type="number" 
                    id="age" 
                    name="age" 
                    min="3" 
                    max="12"
                    value="<%= locals.formData ? formData.age : '' %>"
                    placeholder="От 3 до 12"
                    required
                >
            </div>
            
            <div class="form-group">
                <label for="wish">Что ты хочешь попросить у Деда Мороза?</label>
                <textarea 
                    id="wish" 
                    name="wish" 
                    maxlength="200"
                    placeholder="Напиши своё самое заветное желание..."
                    required><%= locals.formData ? formData.wish : '' %></textarea>
                <small style="color: #666; display: block; margin-top: 5px;">Максимум 200 символов</small>
            </div>
            
            <button type="submit" class="btn">Отправить письмо 🎅</button>
        </form>
    </div>

    <!-- Новогодний снегопад (декоративный) -->
    <script>
        function createSnowflake() {
            const snowflake = document.createElement('div');
            snowflake.classList.add('snowflake');
            snowflake.innerHTML = '❄️';
            snowflake.style.left = Math.random() * 100 + 'vw';
            snowflake.style.animationDuration = Math.random() * 3 + 7 + 's';
            snowflake.style.fontSize = Math.random() * 20 + 10 + 'px';
            document.body.appendChild(snowflake);
            
            setTimeout(() => {
                snowflake.remove();
            }, 10000);
        }
        
        setInterval(createSnowflake, 300);
    </script>
</body>
</html>